PORT=3000

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Replace with your own local PostgreSQL credentials - never commit real ones.
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/clario_db

# Authentication signing secret.
# Generate a long random value for real environments.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Access token lifetime.
ACCESS_TOKEN_TTL=15m

# Cookie name used for the authenticated session.
AUTH_COOKIE_NAME=clario_access

# Comma-separated list of allowed browser origins for cross-origin
# requests (e.g. https://app.example.com,https://admin.example.com).
# Leave unset until the real frontend origin is known - with no value,
# the API sends no CORS headers and browsers deny cross-origin requests
# by default, which is the safe default for a cookie-authenticated API.
CORS_ORIGIN=

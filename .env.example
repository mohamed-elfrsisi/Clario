# Clario Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
# Default: SQLite for local development
# For production with Postgres, change to:
# DATABASE_URL=postgresql://clario:password@postgres:5432/clario
DATABASE_URL=sqlite:///./clario.db

# Server Configuration
# API server will run on this host/port
HOST=0.0.0.0
PORT=8000

# Frontend Configuration
# URL where the Streamlit frontend can reach the API
API_BASE_URL=http://localhost:8000

# Security
# Change this in production to a secure random string
SECRET_KEY=change-this-in-production

# Logging
# Set to 'info' for normal operation, 'debug' for development
LOG_LEVEL=info

# Rate Limiting (optional)
# Maximum number of requests per minute per user
RATE_LIMIT_PER_MINUTE=60

# File Upload Limits
# Maximum file size in bytes (default: 10MB)
MAX_UPLOAD_SIZE=10485760

# Supported file types for upload (comma-separated)
# Allowed: pdf, docx, txt
SUPPORTED_FILE_TYPES=pdf,docx,txt
